+// SPDX-FileCopyrightText: 2026 warriors-4p contributors
+// SPDX-License-Identifier: GPL-3.0+
+//
+// warriors-4p transport layer: datagram transport behind an interface so the lockstep core does not depend on
+// the concrete network method (UDP today; ICE/relay later). Includes a deterministic impairment wrapper for tests.
+
+#pragma once
+
+#include "common/Pcsx2Types.h"
+
+#include <memory>
+#include <string>
+
+namespace W4P
+{
+	struct Endpoint
+	{
+		u32 ipv4 = 0; // host byte order
+		u16 port = 0; // host byte order
+		bool operator==(const Endpoint& o) const { return ipv4 == o.ipv4 && port == o.port; }
+		bool IsValid() const { return port != 0; }
+		std::string ToString() const;
+	};
+
+	bool ParseEndpoint(const std::string& text, Endpoint* out);
+
+	class Transport
+	{
+	public:
+		virtual ~Transport() = default;
+		virtual bool SendTo(const Endpoint& to, const void* data, size_t size) = 0;
+		// Waits up to timeout_ms for one datagram. Returns its size, 0 on timeout, -1 on error.
+		virtual int Receive(void* buffer, size_t capacity, Endpoint* from, int timeout_ms) = 0;
+	};
+
+	// bind_ipv4 = 0 binds all interfaces (LAN/internet; may trigger a firewall prompt), 0x7F000001 loopback only.
+	std::unique_ptr<Transport> CreateUdpTransport(u32 bind_ipv4, u16 listen_port, std::string* error);
+
+	// Delays outgoing datagrams by latency_ms +/- jitter_ms (uniform) and drops them with probability loss
+	// (0..1). Uses a seeded generator so a test run is reproducible from the seed.
+	std::unique_ptr<Transport> CreateImpairedTransport(std::unique_ptr<Transport> inner, int latency_ms,
+		int jitter_ms, float loss, u32 seed);
+} // namespace W4P
