+		// ---- Disconnect handling (BRIEF 4.6: 60 s countdown, then the host chooses; docs/plan/M5.md) ----
+
+		void ScheduleCalls(const std::string& spec, u32 from_t, int pad)
+		{
+			Session& s = *s_session;
+			for (const std::string_view item : StringUtil::SplitString(spec, ','))
+			{
+				const std::vector<std::string_view> f = StringUtil::SplitString(StringUtil::StripWhitespace(item), ':');
+				if (f.size() < 2)
+					continue;
+				CallSpec cs;
+				// from_t is the furthest stall poll among the remaining instances, and an instance stalled there has
+				// already passed its call check for that poll; so offset 0 means the poll after from_t.
+				cs.poll = from_t + 1 - s.c0 + static_cast<u32>(std::strtoul(std::string(f[0]).c_str(), nullptr, 0));
+				cs.fn = static_cast<u32>(std::strtoul(std::string(f[1]).c_str(), nullptr, 16));
+				cs.pad = pad;
+				for (size_t i = 2; i < f.size() && i < 6; i++)
+				{
+					const std::string a(f[i]);
+					if (a == "GM")
+						cs.gamemgr[i - 2] = true;
+					else if (a.rfind("GM+", 0) == 0)
+					{
+						cs.kind[i - 2] = 1;
+						cs.args[i - 2] = static_cast<u32>(std::strtoul(a.c_str() + 3, nullptr, 0));
+					}
+					else if (a == "H")
+						cs.kind[i - 2] = 2;
+					else if (a == "P")
+						cs.kind[i - 2] = 3;
+					else
+						cs.args[i - 2] = static_cast<u32>(std::strtoul(a.c_str(), nullptr, 0));
+				}
+				s.cfg.calls.push_back(cs);
+				Log(fmt::format("session call scheduled at poll {}: {:08x}", cs.poll, cs.fn));
+			}
+		}
+
+		void SendDrop(int player)
+		{
+			Session& s = *s_session;
+			PktDrop pkt = {};
+			FillHeader(&pkt.h, kPktDrop);
+			pkt.player = static_cast<u8>(player);
+			pkt.choice = s.drop_choice[player];
+			pkt.from_t = s.drop_from[player];
+			SendToPeers(&pkt, sizeof(pkt));
+		}
+
+		// The leaving player's inputs this instance holds just before his drop poll, for instances that lack some.
+		void SendRelay(int player)
+		{
+			Session& s = *s_session;
+			const u32 end = s.drop_from[player];
+			const u32 span = std::min<u32>(64, end - s.c0);
+			if (span == 0)
+				return;
+			const u32 first = end - span;
+			std::vector<u8> buf(sizeof(PktRelay) + span * sizeof(Input));
+			PktRelay* pkt = reinterpret_cast<PktRelay*>(buf.data());
+			FillHeader(&pkt->h, kPktRelay);
+			pkt->player = static_cast<u8>(player);
+			pkt->count = static_cast<u16>(span);
+			pkt->first_t = first;
+			Input* out = reinterpret_cast<Input*>(buf.data() + sizeof(PktRelay));
+			for (u32 i = 0; i < span; i++)
+			{
+				out[i] = s.ring[player].in[(first + i) % kRing];
+				out[i].valid = HasReal(player, first + i) ? 1 : 0;
+			}
+			SendToPeers(buf.data(), buf.size());
+		}
+
+		void ApplyDrop(int player, u32 from_t, u8 choice, bool decided_here)
+		{
+			Session& s = *s_session;
+			if (s.dropped[player])
+				return;
+			s.dropped[player] = true;
+			s.drop_from[player] = from_t;
+			s.drop_choice[player] = choice;
+			s.no_accept[player] = true;
+			s.announce_player = player;
+			s.announce_until_ms = NowMs() + 5000.0;
+			s.last_announce_ms = 0.0;
+			Log(fmt::format("player {} leaves the session from poll {} (rel {}): {} ({})", player + 1, from_t, from_t - s.c0,
+				choice == 1 ? "continue without him" : "restart from the last checkpoint without him",
+				decided_here ? "decided here" : "the host's decision"));
+			Host::AddKeyedOSDMessage("w4p_wait",
+				choice == 1 ? fmt::format("Player {} left. The game continues without him.", player + 1) :
+							  fmt::format("Player {} left. Restarting from the last checkpoint without him.", player + 1),
+				8.0f);
+			ScheduleCalls(choice == 2 ? s.cfg.restart_calls : s.cfg.leave_calls, from_t, s.cfg.pad_for_slot[player]);
+		}
+
+		void DisconnectTick(u32 t, double waited_ms)
+		{
+			Session& s = *s_session;
+			const double now = NowMs();
+			if (s.test_silent && s.test_silent_until_ms > 0.0 && now >= s.test_silent_until_ms)
+			{
+				s.test_silent = false;
+				Log("test: network back");
+			}
+			if (s.announce_player >= 0 && now < s.announce_until_ms && now - s.last_announce_ms > 250.0)
+			{
+				s.last_announce_ms = now;
+				SendDrop(s.announce_player);
+				SendRelay(s.announce_player);
+			}
+			if (waited_ms < 500.0)
+				return;
+			// "Gone" = nothing received from him for 2 s; a player who is only behind still sends.
+			std::vector<int> gone;
+			for (int p = 0; p < s.cfg.players; p++)
+			{
+				if (!IsLocalSlot(p) && !s.dropped[p] && now - s.last_rx_ms[p] > 2000.0)
+					gone.push_back(p);
+			}
+			const double timeout_ms = s.cfg.disconnect_timeout_s * 1000.0;
+			bool timed_out = false;
+			double oldest = now;
+			for (const int p : gone)
+			{
+				oldest = std::min(oldest, s.last_rx_ms[p]);
+				if (now - s.last_rx_ms[p] >= timeout_ms)
+				{
+					timed_out = true;
+					s.no_accept[p] = true; // from now on his late inputs would split the instances
+				}
+			}
+			if (now - s.last_status_ms > 250.0)
+			{
+				s.last_status_ms = now;
+				PktStatus pkt = {};
+				FillHeader(&pkt.h, kPktStatus);
+				pkt.stall_t = t;
+				pkt.timed_out = timed_out ? 1 : 0;
+				SendToPeers(&pkt, sizeof(pkt));
+			}
+			std::string who;
+			for (int p = 0; p < s.cfg.players; p++)
+			{
+				if (!Has(p, t))
+					who += fmt::format(" {}", p + 1);
+			}
+			if (gone.empty() || !timed_out)
+			{
+				const double left_s = gone.empty() ? 0.0 : std::ceil((timeout_ms - (now - oldest)) / 1000.0);
+				Host::AddKeyedOSDMessage("w4p_wait", gone.empty() ? fmt::format("Waiting for Player{}...", who) :
+															  fmt::format("Waiting for Player{}... {:.0f}s", who, left_s),
+					1.5f);
+				return;
+			}
+			const int m = gone.front();
+			if (m == 0)
+			{
+				if (!s.host_left_logged)
+				{
+					s.host_left_logged = true;
+					Log("the host did not come back: the session is over");
+				}
+				Host::AddKeyedOSDMessage("w4p_wait", "The host (Player 1) has left. The session is over - you can close the game.", 2.0f);
+				return;
+			}
+			if (s.cfg.local_slot != 0)
+			{
+				Host::AddKeyedOSDMessage("w4p_wait", fmt::format("Player {} did not come back. Waiting for the host's choice...", m + 1), 2.0f);
+				return;
+			}
+			int choice = s.cfg.test_host_choice;
+			if (choice == 0)
+			{
+				InputManager::PollSources();
+				if (PadBase* pad = Pad::GetPad(0, 0))
+				{
+					const u16 b = static_cast<u16>(~pad->GetButtons() & 0xFFFFu);
+					if (b & 0x40)
+						choice = 1; // Cross
+					else if (b & 0x20)
+						choice = 2; // Circle
+				}
+			}
+			// Every other remaining player must report that his timeout has passed too, so nobody still accepts the
+			// leaving player's inputs; the drop poll is the furthest any of them got.
+			u32 from_t = t;
+			std::string not_ready;
+			for (int p = 0; p < s.cfg.players; p++)
+			{
+				if (p == s.cfg.local_slot || s.dropped[p] || std::find(gone.begin(), gone.end(), p) != gone.end())
+					continue;
+				if (s.status_t[p] < 0 || !s.status_timed_out[p] || now - s.status_ms[p] > 2000.0)
+					not_ready += fmt::format(" {}", p + 1);
+				else if (static_cast<s32>(static_cast<u32>(s.status_t[p]) - from_t) > 0)
+					from_t = static_cast<u32>(s.status_t[p]);
+			}
+			if (choice == 0 || !not_ready.empty())
+			{
+				Host::AddKeyedOSDMessage("w4p_wait",
+					fmt::format("Player {} did not come back. Press Cross: continue without Player {}. Press Circle: restart "
+								"from the last checkpoint without Player {}.{}",
+						m + 1, m + 1, m + 1, not_ready.empty() ? "" : fmt::format(" (waiting for Player{})", not_ready)),
+					2.0f);
+				return;
+			}
+			ApplyDrop(m, from_t, static_cast<u8>(choice), true);
+		}
