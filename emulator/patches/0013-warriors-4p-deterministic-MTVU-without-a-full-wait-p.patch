index a8d48a2..f8870c3 100644
--- a/pcsx2/x86/microVU_Misc.inl
+++ b/pcsx2/x86/microVU_Misc.inl
@@ -271,6 +271,7 @@ static void mVUwarningRegAccess(u32 prog, u32 pc)
 
 static void mVUTBit()
 {
+	vu1Thread.W4PNoteFlag(); // warriors-4p
 	u32 old = vu1Thread.mtvuInterrupts.fetch_or(VU_Thread::InterruptFlagVUTBit, std::memory_order_release);
 	if (old & VU_Thread::InterruptFlagVUTBit)
 		DevCon.Warning("Old TBit not registered");
