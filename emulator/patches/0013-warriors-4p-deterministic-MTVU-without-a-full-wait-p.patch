From 6fb5802a73f521f401f840ed85e9c99d8780b9cb Mon Sep 17 00:00:00 2001
From: warriors-4p <w4p@localhost>
Date: Sun, 11 Oct 2026 16:49:16 +0300
Subject: [PATCH] warriors-4p: deterministic MTVU without a full wait per
 vsync; thread use in stats (build w4p-m3-7)

VU1 programs are numbered in queue order; the VU thread records the lowest
number of a program that raised SIGNAL/FINISH/LABEL/T-bit. At each vsync of a
session the EE waits only for programs queued before the previous vsync and
applies the changes (after a full wait) only if one of those raised one, so the
decision depends on emulated state alone. Stats line shows EE/GS/VU thread use.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pcsx2/Gif_Unit.cpp         |  3 +++
 pcsx2/MTVU.cpp             | 35 +++++++++++++++++++++++++++++++++++
 pcsx2/MTVU.h               | 10 ++++++++++
 pcsx2/W4P/W4P.cpp          | 18 +++++++++---------
 pcsx2/x86/microVU_Misc.inl |  1 +
 5 files changed, 58 insertions(+), 9 deletions(-)

diff --git a/pcsx2/Gif_Unit.cpp b/pcsx2/Gif_Unit.cpp
index eefdd51..5e48eb9 100644
--- a/pcsx2/Gif_Unit.cpp
+++ b/pcsx2/Gif_Unit.cpp
@@ -98,11 +98,13 @@ void Gif_HandlerAD_MTVU(u8* pMem)
 		if (vu1Thread.mtvuInterrupts.load(std::memory_order_acquire) & VU_Thread::InterruptFlagSignal)
 			Console.Error("GIF Handler MTVU - Double SIGNAL Not Handled");
 		vu1Thread.gsSignal.store(((u64)data[1] << 32) | data[0], std::memory_order_relaxed);
+		vu1Thread.W4PNoteFlag(); // warriors-4p (before the flag, so the EE sees the program number first)
 		vu1Thread.mtvuInterrupts.fetch_or(VU_Thread::InterruptFlagSignal, std::memory_order_release);
 	}
 	else if (reg == GIF_A_D_REG_FINISH)
 	{ // FINISH
 		GUNIT_WARN("GIF Handler - FINISH");
+		vu1Thread.W4PNoteFlag(); // warriors-4p
 		u32 old = vu1Thread.mtvuInterrupts.fetch_or(VU_Thread::InterruptFlagFinish, std::memory_order_relaxed);
 		if (old & VU_Thread::InterruptFlagFinish)
 			Console.Error("GIF Handler MTVU - Double FINISH Not Handled");
@@ -123,6 +125,7 @@ void Gif_HandlerAD_MTVU(u8* pMem)
 			u32 wantedMsk = existingMsk | labelMsk;
 			wanted = ((u64)wantedMsk << 32) | wantedData;
 		}
+		vu1Thread.W4PNoteFlag(); // warriors-4p
 		vu1Thread.mtvuInterrupts.fetch_or(VU_Thread::InterruptFlagLabel, std::memory_order_release);
 	}
 	else if (reg >= 0x63 && reg != 0x7f)
diff --git a/pcsx2/MTVU.cpp b/pcsx2/MTVU.cpp
index 75ad2bb..360a0b3 100644
--- a/pcsx2/MTVU.cpp
+++ b/pcsx2/MTVU.cpp
@@ -124,6 +124,35 @@ void VU_Thread::Reset()
 	for (size_t i = 0; i < 4; ++i)
 		vu1Thread.vuCycles[i] = 0;
 	vu1Thread.mtvuInterrupts = 0;
+	w4pRunsQueued = 0;
+	w4pPrevQueued = 0;
+	w4pCurRun = 0;
+	w4pRunsDone.store(0, std::memory_order_relaxed);
+	w4pFirstFlagRun.store(0xFFFFFFFFu, std::memory_order_relaxed);
+}
+
+void VU_Thread::W4PNoteFlag()
+{
+	u32 prev = w4pFirstFlagRun.load(std::memory_order_relaxed);
+	while (w4pCurRun < prev && !w4pFirstFlagRun.compare_exchange_weak(prev, w4pCurRun, std::memory_order_release))
+		;
+}
+
+// Called at every vsync start of a lockstep session (an emulated-time point that is the same on every instance).
+// Programs queued before the previous vsync are finished by now in practice, so waiting for them costs almost nothing,
+// and after that wait it is decided by emulated state alone whether one of them raised a change: only then the EE
+// waits for the whole queue and applies the changes (the program numbers do not depend on host timing).
+void VU_Thread::W4PVsync()
+{
+	const u32 target = w4pPrevQueued;
+	while (static_cast<s32>(w4pRunsDone.load(std::memory_order_acquire) - target) < 0)
+		std::this_thread::yield();
+	if (w4pFirstFlagRun.load(std::memory_order_acquire) <= target)
+	{
+		WaitVU();
+		Get_MTVUChanges();
+	}
+	w4pPrevQueued = w4pRunsQueued;
 }
 
 void VU_Thread::ExecuteRingBuffer()
@@ -143,6 +172,7 @@ void VU_Thread::ExecuteRingBuffer()
 			{
 				case MTVU_VU_EXECUTE:
 				{
+					w4pCurRun = w4pRunsDone.load(std::memory_order_relaxed) + 1;
 					VU1.cycle = 0;
 					s32 addr = Read();
 					vifRegs.top = Read();
@@ -156,6 +186,7 @@ void VU_Thread::ExecuteRingBuffer()
 					semaXGkick.Post(); // Tell MTGS a path1 packet is complete
 					vuCycles[vuCycleIdx].store(VU1.cycle, std::memory_order_release);
 					vuCycleIdx = (vuCycleIdx + 1) & 3;
+					w4pRunsDone.fetch_add(1, std::memory_order_release);
 					break;
 				}
 				case MTVU_VU_WRITE_MICRO:
@@ -353,6 +384,9 @@ void VU_Thread::Get_MTVUChanges()
 {
 	// Note: Atomic communication is with Gif_Unit.cpp Gif_HandlerAD_MTVU
 	u32 interrupts = mtvuInterrupts.load(std::memory_order_relaxed);
+	// warriors-4p: in a session this runs only after the EE waited for the whole VU queue, so every raised change
+	// is applied below and nothing is pending any more.
+	w4pFirstFlagRun.store(0xFFFFFFFFu, std::memory_order_relaxed);
 	if (!interrupts)
 		return;
 	if (interrupts & (InterruptFlagSignal | InterruptFlagFinish | InterruptFlagLabel | InterruptFlagVUTBit))
@@ -451,6 +485,7 @@ void VU_Thread::ExecuteVU(u32 vu_addr, u32 vif_top, u32 vif_itop, u32 fbrst)
 	const bool deterministic = W4P::IsActive();
 	if (!deterministic)
 		Get_MTVUChanges(); // Clear any pending interrupts
+	w4pRunsQueued++;
 	ReserveSpace(5);
 	Write(MTVU_VU_EXECUTE);
 	Write(vu_addr);
diff --git a/pcsx2/MTVU.h b/pcsx2/MTVU.h
index d4c47b9..928fad0 100644
--- a/pcsx2/MTVU.h
+++ b/pcsx2/MTVU.h
@@ -50,6 +50,16 @@ public:
 	std::atomic<u64> gsLabel; // Used for GS Label command
 	std::atomic<u64> gsSignal; // Used for GS Signal command
 	u32 w4pFlagEvents = 0; // warriors-4p: SIGNAL/FINISH/LABEL/T-bit changes applied on the EE thread (statistics)
+	// warriors-4p deterministic MTVU: VU1 programs are numbered 1, 2, ... in queue order. The EE counts the queued
+	// ones, the VU thread the finished ones and remembers the lowest number of a program that raised a
+	// SIGNAL/FINISH/LABEL/T-bit change that the EE has not applied yet (0xFFFFFFFF = none).
+	u32 w4pRunsQueued = 0; // EE thread
+	u32 w4pPrevQueued = 0; // EE thread: w4pRunsQueued at the previous vsync
+	u32 w4pCurRun = 0; // VU thread: number of the program being executed
+	std::atomic<u32> w4pRunsDone{0};
+	std::atomic<u32> w4pFirstFlagRun{0xFFFFFFFFu};
+	void W4PNoteFlag(); // VU thread: a program raised one of the changes above
+	void W4PVsync(); // EE thread, vsync start in a session (W4P::OnVsync)
 
 	VU_Thread();
 	~VU_Thread();
