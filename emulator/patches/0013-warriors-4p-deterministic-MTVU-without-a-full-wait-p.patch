@@ -50,7 +51,7 @@ namespace W4P
 		constexpr u32 kRing = 4096; // polls of history kept per player
 		constexpr u32 kPktMagic = 0x4E503457u; // "W4PN"
 		constexpr u16 kProtocolVersion = 2; // 2: hello/fingerprint packet, kernel and game RAM hashes
-		constexpr char kBuildTag[] = "w4p-m3-6";
+		constexpr char kBuildTag[] = "w4p-m3-7";
 		// EE RAM below this address belongs to the BIOS kernel; the game and our patch caves live above it.
 		constexpr u32 kGameRamStart = 0x000A0000; // includes the warriors-4p data/caves (0x000A0000+); 0x81000-0x95FFF holds BIOS/loader leftovers (F-0125)
 		constexpr int kResendBurst = 32; // local inputs repeated in every input packet (loss tolerance)
@@ -1152,13 +1153,11 @@ namespace W4P
 	{
 		if (!s_session)
 			return;
-		// Deterministic MTVU: apply the VU thread's pending GS/T-bit changes at a fixed emulated point (vsync start),
-		// after waiting for the VU thread, so every instance sees them at the same cycle (F-0120, F-0124).
+		// Deterministic MTVU: the VU thread's GS/T-bit changes reach the EE only at fixed emulated points (here: vsync
+		// start, decided by VU1 program numbers, not by host timing), so every instance sees them at the same cycle
+		// (F-0120, F-0124, F-0138).
 		if (THREAD_VU1)
-		{
-			vu1Thread.WaitVU();
-			vu1Thread.Get_MTVUChanges();
-		}
+			vu1Thread.W4PVsync();
 		Session& s = *s_session;
 		Receive(0);
 		bool all_hello = true;
@@ -1174,9 +1173,10 @@ namespace W4P
 		if (s.started && now - s.last_stats_ms > 10000.0)
 		{
 			s.last_stats_ms = now;
-			Log(fmt::format("stats: poll {}, polls {}, waits {}, wait total {:.1f} ms, max {:.1f} ms, hashes {}, mismatches {}, kernel-only differences {}, mtvu {} (flag events {})",
+			Log(fmt::format("stats: poll {}, polls {}, waits {}, wait total {:.1f} ms, max {:.1f} ms, hashes {}, mismatches {}, kernel-only differences {}, mtvu {} (flag events {}), thread use ee {:.0f}% gs {:.0f}% vu {:.0f}%",
 				s.cur_t - s.c0, s.polls, s.waits, s.wait_ms_total, s.wait_ms_max, s.hashes_compared, s.mismatches, s.kernel_mismatches,
-				THREAD_VU1 ? "on" : "off", vu1Thread.w4pFlagEvents));
+				THREAD_VU1 ? "on" : "off", vu1Thread.w4pFlagEvents, PerformanceMetrics::GetCPUThreadUsage(),
+				PerformanceMetrics::GetGSThreadUsage(), PerformanceMetrics::GetVUThreadUsage()));
 		}
 	}
 
