+		u64 Fnv(u64 h, const void* data, size_t n)
+		{
+			const u8* b = static_cast<const u8*>(data);
+			for (size_t i = 0; i < n; i++)
+				h = (h ^ b[i]) * 0x100000001B3ull;
+			return h;
+		}
+
+		template <typename T>
+		u64 FnvVal(u64 h, T v)
+		{
+			return Fnv(h, &v, sizeof(v));
+		}
+
+		// Emulation settings that change what the emulated machine computes. Graphics settings are not included
+		// (they do not affect the simulation; evidence/M3/x1_mixed_gfx.json).
+		u64 SettingsFingerprint()
+		{
+			u64 h = 0xCBF29CE484222325ull;
+			h = FnvVal(h, EmuConfig.Cpu.bitset);
+			h = FnvVal(h, EmuConfig.Cpu.Recompiler.bitset);
+			h = FnvVal(h, EmuConfig.Cpu.FPUFPCR.bitmask);
+			h = FnvVal(h, EmuConfig.Cpu.FPUDivFPCR.bitmask);
+			h = FnvVal(h, EmuConfig.Cpu.VU0FPCR.bitmask);
+			h = FnvVal(h, EmuConfig.Cpu.VU1FPCR.bitmask);
+			h = FnvVal(h, EmuConfig.Speedhacks.bitset);
+			h = FnvVal(h, EmuConfig.Speedhacks.EECycleRate);
+			h = FnvVal(h, EmuConfig.Speedhacks.EECycleSkip);
+			h = FnvVal(h, EmuConfig.Gamefixes.bitset);
+			const bool flags[] = {EmuConfig.EnablePatches, EmuConfig.EnableCheats, EmuConfig.EnableWideScreenPatches,
+				EmuConfig.EnableNoInterlacingPatches, EmuConfig.EnableFastBoot, EmuConfig.EnableGameFixes,
+				EmuConfig.ManuallySetRealTimeClock, EmuConfig.HostFs};
+			h = Fnv(h, flags, sizeof(flags));
+			if (EmuConfig.ManuallySetRealTimeClock)
+			{
+				const int rtc[] = {EmuConfig.RtcYear, EmuConfig.RtcMonth, EmuConfig.RtcDay, EmuConfig.RtcHour,
+					EmuConfig.RtcMinute, EmuConfig.RtcSecond};
+				h = Fnv(h, rtc, sizeof(rtc));
+			}
+			return h;
+		}
+
+		void SendHello()
+		{
+			Session& s = *s_session;
+			PktHello pkt = {};
+			FillHeader(&pkt.h, kPktHello);
+			pkt.disc_crc = VMManager::GetDiscCRC();
+			pkt.bios_version = BiosVersion;
+			pkt.settings_fp = SettingsFingerprint();
+			pkt.patch_fp = Fnv(0xCBF29CE484222325ull, s.cfg.patch_set.data(), s.cfg.patch_set.size());
+			pkt.players = static_cast<u8>(s.cfg.players);
+			pkt.input_delay = static_cast<u8>(s.cfg.input_delay);
+			pkt.hash_interval = static_cast<u16>(s.cfg.hash_interval);
+			std::snprintf(pkt.build, sizeof(pkt.build), "%s", kBuildTag);
+			std::snprintf(pkt.bios, sizeof(pkt.bios), "%s", BiosDescription.c_str());
+			SendToPeers(&pkt, sizeof(pkt));
+			s.last_hello_ms = NowMs();
+		}
+
+		void HandleHello(const PktHello& in)
+		{
+			Session& s = *s_session;
+			const int p = in.h.slot;
+			const bool first = !s.hello_from[p];
+			s.hello_from[p] = true;
+			if (first)
+				SendHello(); // make sure the peer gets ours even if our earlier one was lost
+			else
+				return;
+			char bios[sizeof(in.bios) + 1] = {};
+			char build[sizeof(in.build) + 1] = {};
+			std::memcpy(bios, in.bios, sizeof(in.bios));
+			std::memcpy(build, in.build, sizeof(in.build));
+			Log(fmt::format("hello from slot {}: build {}, disc CRC {:08X}, BIOS {:08X} '{}', settings {:016x}, patches {:016x}, "
+							"players {}, delay {}, hash every {}",
+				p, build, in.disc_crc, in.bios_version, bios, in.settings_fp, in.patch_fp, in.players, in.input_delay,
+				in.hash_interval));
+			std::string diff;
+			if (std::strncmp(build, kBuildTag, sizeof(in.build)) != 0)
+				diff += " emulator build,";
+			if (in.disc_crc != VMManager::GetDiscCRC())
+				diff += " game version,";
+			if (in.settings_fp != SettingsFingerprint())
+				diff += " emulation settings,";
+			if (in.patch_fp != Fnv(0xCBF29CE484222325ull, s.cfg.patch_set.data(), s.cfg.patch_set.size()))
+				diff += " game patches,";
+			if (in.players != s.cfg.players || in.input_delay != s.cfg.input_delay || in.hash_interval != s.cfg.hash_interval)
+				diff += " session options,";
+			if (!diff.empty())
+			{
+				diff.pop_back();
+				Log(fmt::format("ERROR: player {} differs in:{}", p + 1, diff));
+				Host::AddKeyedOSDMessage(fmt::format("w4p_hello{}", p),
+					fmt::format("Player {} uses different{}. The game will go out of sync.", p + 1, diff), 30.0f);
+			}
+			else if (in.bios_version != BiosVersion)
+			{
+				Log(fmt::format("WARNING: player {} uses a different BIOS version ({:08X}, ours {:08X})", p + 1, in.bios_version, BiosVersion));
+				Host::AddKeyedOSDMessage(fmt::format("w4p_hello{}", p),
+					fmt::format("Player {} uses a different PS2 BIOS version. This may cause desync.", p + 1), 15.0f);
+			}
+			else
+			{
+				Host::AddKeyedOSDMessage(fmt::format("w4p_hello{}", p), fmt::format("Connected to Player {}", p + 1), 5.0f);
+			}
+		}
+
 		void SendInputs()
 		{
 			Session& s = *s_session;
@@ -322,10 +453,10 @@ namespace W4P
