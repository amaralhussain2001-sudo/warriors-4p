-		u64 HashMainRam()
+		u64 HashRange(const u64* p, size_t n)
 		{
-			// Fast non-cryptographic 64-bit hash of all EE main RAM; only used to detect divergence.
-			const u64* p = reinterpret_cast<const u64*>(eeMem->Main);
-			const size_t n = Ps2MemSize::MainRam / sizeof(u64);
+			// Fast non-cryptographic 64-bit hash; only used to detect divergence.
 			u64 h1 = 0x9E3779B97F4A7C15ull, h2 = 0xC2B2AE3D27D4EB4Full;
-			for (size_t i = 0; i < n; i += 2)
+			for (size_t i = 0; i + 1 < n; i += 2)
 			{
 				h1 = (h1 ^ p[i]) * 0x100000001B3ull;
 				h2 = (h2 ^ p[i + 1]) * 0x880355F21E6D1965ull;
@@ -420,6 +561,18 @@ namespace W4P
 			return h1 ^ (h2 >> 1) ^ (h2 << 63);
 		}
 
+		HashEntry HashMainRam(u32 t)
+		{
+			const u64* p = reinterpret_cast<const u64*>(eeMem->Main);
+			const size_t k = kGameRamStart / sizeof(u64);
+			return {t, HashRange(p, k), HashRange(p + k, Ps2MemSize::MainRam / sizeof(u64) - k)};
+		}
+
+		u64 Combined(const HashEntry& e)
+		{
+			return e.kernel ^ ((e.game << 1) | (e.game >> 63));
+		}
+
