From bb684262a1f54122ea525846b40d24983b98f8df Mon Sep 17 00:00:00 2001
From: warriors-4p <w4p@localhost>
Date: Sun, 11 Oct 2026 01:22:09 +0300
Subject: [PATCH] warriors-4p: crop follows the picture (GS queue + frame
 delay), edge inset, view toggle hotkey, block savestates/speed changes in
 sessions

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pcsx2/Input/InputManager.cpp |   2 +-
 pcsx2/Input/InputManager.h   |   1 +
 pcsx2/VMManager.cpp          |  18 +++++
 pcsx2/W4P/W4P.cpp            | 130 +++++++++++++++++++++++++++++------
 pcsx2/W4P/W4P.h              |   7 ++
 5 files changed, 136 insertions(+), 22 deletions(-)

diff --git a/pcsx2/Input/InputManager.cpp b/pcsx2/Input/InputManager.cpp
index 813b6da..e1e662b 100644
--- a/pcsx2/Input/InputManager.cpp
+++ b/pcsx2/Input/InputManager.cpp
@@ -153,7 +153,7 @@ static std::atomic<InputLayout> s_gamepad_icon_preference = InputLayout::Unknown
 // ------------------------------------------------------------------------
 // Hotkeys
 // ------------------------------------------------------------------------
-static const HotkeyInfo* const s_hotkey_list[] = {g_common_hotkeys, g_gs_hotkeys, g_host_hotkeys};
+static const HotkeyInfo* const s_hotkey_list[] = {g_common_hotkeys, g_gs_hotkeys, g_host_hotkeys, g_w4p_hotkeys};
 
 // ------------------------------------------------------------------------
 // Tracking host mouse movement and turning into relative events
diff --git a/pcsx2/Input/InputManager.h b/pcsx2/Input/InputManager.h
index 6944355..aa210cf 100644
--- a/pcsx2/Input/InputManager.h
+++ b/pcsx2/Input/InputManager.h
@@ -147,6 +147,7 @@ struct HotkeyInfo
 DECLARE_HOTKEY_LIST(g_common_hotkeys);
 DECLARE_HOTKEY_LIST(g_gs_hotkeys);
 DECLARE_HOTKEY_LIST(g_host_hotkeys);
+DECLARE_HOTKEY_LIST(g_w4p_hotkeys); // warriors-4p
 
 /// Host mouse relative axes are X, Y, wheel horizontal, wheel vertical.
 enum class InputPointerAxis : u8
diff --git a/pcsx2/VMManager.cpp b/pcsx2/VMManager.cpp
index b7de07f..537b206 100644
--- a/pcsx2/VMManager.cpp
+++ b/pcsx2/VMManager.cpp
@@ -2088,6 +2088,12 @@ u32 VMManager::DeleteSaveStates(const char* game_serial, u32 game_crc, bool also
 
 bool VMManager::LoadState(const char* filename, Error* error)
 {
+	if (W4P::BlockInSession("Loading a savestate")) // warriors-4p
+	{
+		Error::SetString(error, "Loading a savestate is not available in an online session.");
+		return false;
+	}
+
 	if (Achievements::IsHardcoreModeActive())
 	{
 		Error::SetString(error,
@@ -2114,6 +2120,12 @@ bool VMManager::LoadState(const char* filename, Error* error)
 
 bool VMManager::LoadStateFromSlot(s32 slot, bool backup, Error* error)
 {
+	if (W4P::BlockInSession("Loading a savestate")) // warriors-4p
+	{
+		Error::SetString(error, "Loading a savestate is not available in an online session.");
+		return false;
+	}
+
 	const std::string filename = GetCurrentSaveStateFileName(slot, backup);
 	if (filename.empty() || !FileSystem::FileExists(filename.c_str()))
 	{
@@ -2204,6 +2216,9 @@ LimiterModeType VMManager::GetLimiterMode()
 
 void VMManager::SetLimiterMode(LimiterModeType type)
 {
+	if (type != LimiterModeType::Nominal && W4P::BlockInSession("Changing the game speed")) // warriors-4p
+		return;
+
 	if (s_limiter_mode == type)
 		return;
 
@@ -2357,6 +2372,9 @@ void VMManager::Internal::FrameRateChanged()
 
 void VMManager::FrameAdvance(u32 num_frames /*= 1*/)
 {
+	if (W4P::BlockInSession("Frame advance")) // warriors-4p
+		return;
+
 	if (!HasValidVM())
 		return;
 
diff --git a/pcsx2/W4P/W4P.cpp b/pcsx2/W4P/W4P.cpp
index d50431b..e8618f7 100644
--- a/pcsx2/W4P/W4P.cpp
+++ b/pcsx2/W4P/W4P.cpp
@@ -9,6 +9,8 @@
 
 #include "Host.h"
 #include "INISettingsInterface.h"
+#include "Input/InputManager.h"
+#include "MTGS.h"
 #include "Memory.h"
 #include "R5900.h"
 #include "SIO/Pad/Pad.h"
@@ -24,9 +26,11 @@
 
 #include <algorithm>
 #include <array>
+#include <atomic>
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <deque>
 #include <memory>
 #include <mutex>
 #include <string>
@@ -48,6 +52,7 @@ namespace W4P
 		constexpr u32 kViewsRendered = 0x0050B198;
 		constexpr u32 kLayoutRows = 0x0050B1A8;
 		constexpr u32 kLayoutCols = 0x0050B1AA;
+		constexpr u32 kFrameCounter = 0x0050C654; // game frames, advanced by FrameStats (F-0042)
 
 		// Offsets inside the game's per-pad port buffer (F-0051).
 		constexpr u32 kPortOffPort = 0x104;
@@ -120,6 +125,10 @@ namespace W4P
 			float loss = 0.0f;
 			u32 seed = 1;
 			bool crop = true;
+			// The game's view count changes about 4 game frames before the matching picture is shown (F-0093).
+			// The crop uses the layout from this many game frames ago and travels through the GS queue.
+			int crop_delay_frames = 3;
+			float crop_inset = 0.01f; // trimmed from edges shared with another view (fraction of the full frame)
 			s64 corrupt_poll = -1; // test only: flip a button in this instance at poll (t - c0)
 		};
 
@@ -162,10 +171,23 @@ namespace W4P
 		};
 
 		std::unique_ptr<Session> s_session;
+		// Crop state as seen by the GS thread. Written on the GS thread (through MTGS::RunOnGSThread, in order
+		// with the frames) or at shutdown; the mutex covers the shutdown case.
 		std::mutex s_crop_mutex;
 		bool s_crop_on = false;
 		float s_crop[4] = {0.0f, 0.0f, 1.0f, 1.0f};
 
+		// CPU-thread side of the crop: layout history per game frame and the last crop sent to the GS thread.
+		struct LayoutRec
+		{
+			u32 frame, views, cols, rows;
+		};
+		std::deque<LayoutRec> s_layout_hist;
+		bool s_sent_valid = false;
+		bool s_sent_on = false;
+		float s_sent[4] = {};
+		std::atomic<bool> s_show_all{false}; // player's choice: all players' views instead of their own
+
 		double NowMs()
 		{
 			return Common::Timer::ConvertValueToMilliseconds(Common::Timer::GetCurrentValue());
@@ -587,29 +609,64 @@ namespace W4P
 			Log(fmt::format("bot input: {} polls from {}", s_session->bot.size(), path));
 		}
 
-		void UpdateCrop()
-		{
-			bool on = false;
-			float r[4] = {0.0f, 0.0f, 1.0f, 1.0f};
-			if (s_session->cfg.crop)
+		bool CropFor(const LayoutRec& l, float* r)
+		{
+			r[0] = 0.0f, r[1] = 0.0f, r[2] = 1.0f, r[3] = 1.0f;
+			const u32 idx = static_cast<u32>(s_session->cfg.local_slot);
+			const u32 cols = l.cols, rows = l.rows;
+			if (!s_session->cfg.crop || s_show_all.load() || l.views < 2 || cols < 1 || rows < 1 || cols * rows < 2 ||
+				idx >= l.views || cols > 2 || rows > 2)
+				return false;
+			const u32 col = idx % cols, row = idx / cols;
+			r[0] = static_cast<float>(col) / cols;
+			r[1] = static_cast<float>(row) / rows;
+			r[2] = static_cast<float>(col + 1) / cols;
+			r[3] = static_cast<float>(row + 1) / rows;
+			// Trim the same amount from each shared edge, so the picture keeps its proportions.
+			const float in = s_session->cfg.crop_inset;
+			if (cols == 2)
 			{
-				const u32 views = memRead32(kViewsRendered);
-				const u32 cols = memRead16(kLayoutCols);
-				const u32 rows = memRead16(kLayoutRows);
-				const u32 idx = static_cast<u32>(s_session->cfg.local_slot);
-				if (views >= 2 && cols >= 1 && rows >= 1 && cols * rows >= 2 && idx < views && cols <= 2 && rows <= 2)
-				{
-					const u32 col = idx % cols, row = idx / cols;
-					r[0] = static_cast<float>(col) / cols;
-					r[1] = static_cast<float>(row) / rows;
-					r[2] = static_cast<float>(col + 1) / cols;
-					r[3] = static_cast<float>(row + 1) / rows;
-					on = true;
-				}
+				if (col == 0)
+					r[2] -= in;
+				else
+					r[0] += in;
 			}
-			std::lock_guard<std::mutex> lock(s_crop_mutex);
-			s_crop_on = on;
-			std::memcpy(s_crop, r, sizeof(r));
+			if (rows == 2)
+			{
+				if (row == 0)
+					r[3] -= in;
+				else
+					r[1] += in;
+			}
+			return true;
+		}
+
+		void UpdateCrop()
+		{
+			const LayoutRec now = {memRead32(kFrameCounter), memRead32(kViewsRendered), memRead16(kLayoutCols),
+				memRead16(kLayoutRows)};
+			if (s_layout_hist.empty() || std::memcmp(&s_layout_hist.back(), &now, sizeof(now)) != 0)
+				s_layout_hist.push_back(now);
+			while (s_layout_hist.size() > 64)
+				s_layout_hist.pop_front();
+			// newest layout that belongs to a frame at least crop_delay_frames old
+			const u32 delay = static_cast<u32>(std::max(0, s_session->cfg.crop_delay_frames));
+			const LayoutRec* use = &s_layout_hist.front();
+			for (const LayoutRec& l : s_layout_hist)
+				if (now.frame - l.frame >= delay)
+					use = &l;
+			float r[4];
+			const bool on = CropFor(*use, r);
+			if (s_sent_valid && on == s_sent_on && std::memcmp(r, s_sent, sizeof(r)) == 0)
+				return;
+			s_sent_valid = true;
+			s_sent_on = on;
+			std::memcpy(s_sent, r, sizeof(r));
+			MTGS::RunOnGSThread([on, r0 = r[0], r1 = r[1], r2 = r[2], r3 = r[3]]() {
+				std::lock_guard<std::mutex> lock(s_crop_mutex);
+				s_crop_on = on;
+				s_crop[0] = r0, s_crop[1] = r1, s_crop[2] = r2, s_crop[3] = r3;
+			});
 		}
 	} // namespace
 
@@ -654,6 +711,9 @@ namespace W4P
 		c.loss = ini.GetFloatValue("W4P", "ImpairLoss", 0.0f);
 		c.seed = static_cast<u32>(ini.GetIntValue("W4P", "ImpairSeed", 1));
 		c.crop = ini.GetBoolValue("W4P", "Crop", true);
+		c.crop_delay_frames = ini.GetIntValue("W4P", "CropDelayFrames", c.crop_delay_frames);
+		c.crop_inset = std::clamp(ini.GetFloatValue("W4P", "CropInset", c.crop_inset), 0.0f, 0.1f);
+		s_show_all.store(ini.GetBoolValue("W4P", "ShowAllViews", false));
 		c.corrupt_poll = ini.GetIntValue("W4P", "TestCorruptPoll", -1);
 		if (!c.enabled)
 			return;
@@ -697,10 +757,30 @@ namespace W4P
 		if (s.log)
 			std::fclose(s.log);
 		s_session.reset();
+		s_layout_hist.clear();
+		s_sent_valid = false;
 		std::lock_guard<std::mutex> lock(s_crop_mutex);
 		s_crop_on = false;
 	}
 
+	void ToggleAllViews()
+	{
+		if (!s_session)
+			return;
+		const bool all = !s_show_all.load();
+		s_show_all.store(all);
+		Host::AddKeyedOSDMessage("W4PViews", all ? "Showing all players' views" : "Showing your own view", 2.0f);
+		Log(all ? "view: all players" : "view: own");
+	}
+
+	bool BlockInSession(const char* what)
+	{
+		if (!s_session)
+			return false;
+		Host::AddKeyedOSDMessage("W4PBlocked", fmt::format("{} is not available in an online session", what), 3.0f);
+		return true;
+	}
+
 	bool IsActive()
 	{
 		return s_session != nullptr;
@@ -753,3 +833,11 @@ namespace W4P
 		return true;
 	}
 } // namespace W4P
+
+BEGIN_HOTKEY_LIST(g_w4p_hotkeys)
+DEFINE_HOTKEY("W4PToggleAllViews", TRANSLATE_NOOP("Hotkeys", "Online Co-op"),
+	TRANSLATE_NOOP("Hotkeys", "Switch Between My View and All Players' Views"), [](s32 pressed) {
+		if (!pressed)
+			W4P::ToggleAllViews();
+	})
+END_HOTKEY_LIST()
diff --git a/pcsx2/W4P/W4P.h b/pcsx2/W4P/W4P.h
index 42be452..b993512 100644
--- a/pcsx2/W4P/W4P.h
+++ b/pcsx2/W4P/W4P.h
@@ -33,4 +33,11 @@ namespace W4P
 	// Presentation-only crop of the displayed frame, as fractions of the frame (x0, y0, x1, y1).
 	// Returns false when the whole frame should be shown. Safe to call from the GS thread.
 	bool GetPresentationCrop(float* out4);
+
+	// The local player's choice between their own view and all players' views (hotkey W4PToggleAllViews).
+	void ToggleAllViews();
+
+	// Returns true (and shows an on-screen message) when an action that would break lockstep must be refused,
+	// for example loading a savestate or changing the emulation speed during a session.
+	bool BlockInSession(const char* what);
 } // namespace W4P
-- 
