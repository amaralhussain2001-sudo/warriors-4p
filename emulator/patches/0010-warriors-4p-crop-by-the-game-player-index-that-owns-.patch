From 843a16031a5ebc9098b2c3d09dffc1dd73505464 Mon Sep 17 00:00:00 2001
From: warriors-4p <w4p@localhost>
Date: Sun, 11 Oct 2026 07:54:24 +0300
Subject: [PATCH] warriors-4p: crop by the game player index that owns the
 local pad

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pcsx2/W4P/W4P.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/pcsx2/W4P/W4P.cpp b/pcsx2/W4P/W4P.cpp
index 96de186..7d62766 100644
--- a/pcsx2/W4P/W4P.cpp
+++ b/pcsx2/W4P/W4P.cpp
@@ -874,7 +874,11 @@ namespace W4P
 		bool CropFor(const LayoutRec& l, float* r)
 		{
 			r[0] = 0.0f, r[1] = 0.0f, r[2] = 1.0f, r[3] = 1.0f;
-			const u32 idx = static_cast<u32>(s_session->cfg.local_slot);
+			// The view is the game's player index of the human that owns this PC's controller (pad state +0x42, -1 = none);
+			// it differs from the session slot when players join in a different order (F-0127).
+			const int pad = s_session->cfg.pad_for_slot[s_session->cfg.local_slot];
+			const s16 owner = static_cast<s16>(memRead16(0x005DD810 + static_cast<u32>(pad) * 0x50 + 0x42));
+			const u32 idx = owner >= 0 ? static_cast<u32>(owner) : static_cast<u32>(s_session->cfg.local_slot);
 			const u32 cols = l.cols, rows = l.rows;
 			if (!s_session->cfg.crop || s_show_all.load() || l.views < 2 || cols < 1 || rows < 1 || cols * rows < 2 ||
 				idx >= l.views || cols > 2 || rows > 2)
