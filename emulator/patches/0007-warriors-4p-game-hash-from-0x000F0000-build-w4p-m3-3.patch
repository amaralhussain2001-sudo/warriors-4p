 	int VibrationPadFor(u32 unified_slot);
+
+	// Debug only (config DebugWatch = addr[:size],...): memory write watchpoints that are logged instead of pausing.
+	// Returns true when the hit was ours and execution should continue.
+	bool OnDebugMemcheck(u32 pc, u32 start);
 } // namespace W4P
