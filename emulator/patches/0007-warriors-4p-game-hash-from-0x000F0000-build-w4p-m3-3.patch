@@ -167,6 +172,7 @@ namespace W4P
 			std::unique_ptr<Transport> net;
 			std::FILE* log = nullptr;
 			std::vector<Input> bot;
+			std::array<std::vector<Input>, kMaxPlayers> local_bots = {};
 
 			bool started = false;
 			u32 c0 = 0;
@@ -306,6 +312,12 @@ namespace W4P
 			return in;
 		}
 
+		// True for the local slot and for slots simulated here from a test input file.
+		bool IsLocalSlot(int p)
+		{
+			return p == s_session->cfg.local_slot || !s_session->local_bots[p].empty();
+		}
+
 		void FillHeader(PktHeader* h, u8 type)
 		{
 			h->magic = kPktMagic;
@@ -639,7 +651,7 @@ namespace W4P
 				bool all = true;
 				for (int p = 0; p < s.cfg.players && all; p++)
 				{
-					if (p != s.cfg.local_slot && s.remote_hash[p].find(t) == s.remote_hash[p].end())
+					if (!IsLocalSlot(p) && s.remote_hash[p].find(t) == s.remote_hash[p].end())
 						all = false;
 				}
 				if (!all)
@@ -650,7 +662,7 @@ namespace W4P
 				const HashEntry mine = s.local_hash[t];
 				for (int p = 0; p < s.cfg.players; p++)
 				{
-					if (p == s.cfg.local_slot)
+					if (IsLocalSlot(p))
 						continue;
 					s.hashes_compared++;
 					const HashEntry& other = s.remote_hash[p][t];
@@ -735,6 +747,11 @@ namespace W4P
 			{
 				s.local_upto++;
 				Store(s.cfg.local_slot, s.local_upto, SampleLocal(s.local_upto));
+				for (int p = 0; p < s.cfg.players; p++)
+				{
+					if (p != s.cfg.local_slot && !s.local_bots[p].empty())
+						Store(p, s.local_upto, s.local_bots[p][(s.local_upto - s.c0) % s.local_bots[p].size()]);
+				}
 			}
 			SendInputs();
 			Receive(0);
@@ -810,8 +827,9 @@ namespace W4P
 				DumpRam(t);
 		}
 
-		void LoadBot(const std::string& path)
+		void LoadBot(const std::string& path, std::vector<Input>* into = nullptr)
 		{
+			std::vector<Input>& dst = into ? *into : s_session->bot;
 			std::FILE* f = FileSystem::OpenCFile(path.c_str(), "rb");
 			if (!f)
 			{
@@ -822,10 +840,10 @@ namespace W4P
 			while (std::fread(&in, sizeof(in), 1, f) == 1)
 			{
 				in.valid = 1;
-				s_session->bot.push_back(in);
+				dst.push_back(in);
 			}
 			std::fclose(f);
-			Log(fmt::format("bot input: {} polls from {}", s_session->bot.size(), path));
+			Log(fmt::format("bot input: {} polls from {}", dst.size(), path));
 		}
 
 		bool CropFor(const LayoutRec& l, float* r)
@@ -925,12 +943,24 @@ namespace W4P
 		c.log_path = ini.GetStringValue("W4P", "LogFile", "");
 		c.dump_dir = ini.GetStringValue("W4P", "DumpDir", "");
 		c.bot_path = ini.GetStringValue("W4P", "BotInput", "");
+		for (int p = 0; p < kMaxPlayers; p++)
+			c.local_bot_paths[p] = ini.GetStringValue("W4P", fmt::format("LocalBot{}", p).c_str(), "");
 		c.latency_ms = ini.GetIntValue("W4P", "ImpairLatencyMs", 0);
 		c.jitter_ms = ini.GetIntValue("W4P", "ImpairJitterMs", 0);
 		c.loss = ini.GetFloatValue("W4P", "ImpairLoss", 0.0f);
 		c.seed = static_cast<u32>(ini.GetIntValue("W4P", "ImpairSeed", 1));
 		c.crop = ini.GetBoolValue("W4P", "Crop", true);
 		c.patch_set = ini.GetStringValue("W4P", "PatchSet", "");
+		for (const std::string_view item : StringUtil::SplitString(ini.GetStringValue("W4P", "DebugWatch", ""), ','))
+		{
+			const std::string w(StringUtil::StripWhitespace(item));
+			if (w.empty())
+				continue;
+			const size_t colon = w.find(':');
+			const u32 a = static_cast<u32>(std::strtoul(w.substr(0, colon).c_str(), nullptr, 0));
+			const u32 n = colon == std::string::npos ? 4u : static_cast<u32>(std::strtoul(w.substr(colon + 1).c_str(), nullptr, 0));
+			c.watches.emplace_back(a, a + n);
+		}
 		c.crop_delay_frames = ini.GetIntValue("W4P", "CropDelayFrames", c.crop_delay_frames);
 		c.crop_inset = std::clamp(ini.GetFloatValue("W4P", "CropInset", c.crop_inset), 0.0f, 0.1f);
 		s_show_all.store(ini.GetBoolValue("W4P", "ShowAllViews", false));
@@ -965,6 +995,16 @@ namespace W4P
 		}
 		if (!c.bot_path.empty())
 			LoadBot(c.bot_path);
+		for (const auto& [a, e] : c.watches)
+		{
+			CBreakPoints::AddMemCheck(BREAKPOINT_EE, a, e, MEMCHECK_WRITE, MEMCHECK_BREAK);
+			Log(fmt::format("debug watch on writes to {:08x}..{:08x}", a, e));
+		}
+		for (int p = 0; p < c.players; p++)
+		{
+			if (p != c.local_slot && !c.local_bot_paths[p].empty())
+				LoadBot(c.local_bot_paths[p], &s_session->local_bots[p]);
+		}
 		Log(fmt::format("enabled: {} players, local slot {}, listen UDP {}", c.players, c.local_slot, c.listen_port));
 	}
 
@@ -1005,6 +1045,26 @@ namespace W4P
 		return unified == unified_slot ? 0 : -1;
 	}
 
+	bool OnDebugMemcheck(u32 pc, u32 start)
+	{
+		if (!s_session)
+			return false;
+		for (const auto& [a, e] : s_session->cfg.watches)
+		{
+			if (a != start)
+				continue;
+			// The check runs before the store: log the instruction, the register it stores and the old value.
+			const u32 op = memRead32(pc);
+			const u32 rt = (op >> 16) & 31;
+			const u32 opc = op >> 26;
+			const u64 val = (opc == 0x39 || opc == 0x31) ? fpuRegs.fpr[rt].UL : cpuRegs.GPR.r[rt].UD[0];
+			Log(fmt::format("WATCH write pc {:08x} op {:08x} ra {:08x} value {:016x} old {:08x} poll {}", pc, op,
+				cpuRegs.GPR.n.ra.UL[0], val, memRead32(a), s_session->cur_t - s_session->c0));
+			return true;
+		}
+		return false;
+	}
+
 	bool BlockInSession(const char* what)
 	{
 		if (!s_session)
@@ -1045,7 +1105,7 @@ namespace W4P
 		Receive(0);
 		bool all_hello = true;
 		for (int p = 0; p < s.cfg.players; p++)
-			all_hello &= (p == s.cfg.local_slot || (s.hello_from[p] && (!s.started || s.compared_from[p])));
+			all_hello &= (IsLocalSlot(p) || (s.hello_from[p] && (!s.started || s.compared_from[p])));
 		if (!all_hello && NowMs() - s.last_hello_ms > 1000.0)
 			SendHello();
 		if (s.started && NowMs() - s.last_send_ms > 50.0)
