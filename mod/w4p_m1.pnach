patch=2,EE,0037D6C8,word,0C03B400 // D24: was 0C102824 jal 0x0040A090 (lua_register of HuSetButtonTapControl in FUN_0037D420) -> jal 0x000ED000 REGW; delay slot daddu a1,zero,zero kept
patch=2,EE,00234490,word,0803B480 // D24: was 24030002 addiu v1,zero,2 (FUN_00234318 tap off: 'player count == 2' test) -> j 0x000ED200 TAPOFF
patch=2,EE,00234494,word,00000000 // D24: was 8E44489C lw a0,0x489c(s2) -> nop (delay slot); 0x00234498-0x00234514 now unused
patch=2,EE,000ED000,word,27BDFFE0 // REGW: addiu sp, sp, -32  ; REGW(L, 0, name, fn): replaces the jal 0x0040A090 at 0x0037D6C8 (registration of HuSetButtonTapControl in FUN_0037D420)
patch=2,EE,000ED004,word,FFBF0000 // sd ra, 0x0(sp)
patch=2,EE,000ED008,word,7FB00010 // sq s0, 0x10(sp)
patch=2,EE,000ED00C,word,0C102824 // jal 0x0040A090  ; the replaced call: lua_register(L, "HuSetButtonTapControl", 0x00358930) (pushcclosure + setglobal)
patch=2,EE,000ED010,word,0080802D // daddu s0, a0, zero  ; L
patch=2,EE,000ED014,word,0200202D // daddu a0, s0, zero
patch=2,EE,000ED018,word,0000282D // daddu a1, zero, zero
patch=2,EE,000ED01C,word,3C06000E // lui a2, 0x000E
patch=2,EE,000ED020,word,34C6D3C0 // ori a2, a2, 0xD3C0  ; "W4P_JoinAs"
patch=2,EE,000ED024,word,3C07000E // lui a3, 0x000E
patch=2,EE,000ED028,word,0C102824 // jal 0x0040A090  ; register our Lua function W4P_JoinAs(handle) = JOINAS
patch=2,EE,000ED02C,word,34E7D040 // ori a3, a3, 0xD040  ; JOINAS
patch=2,EE,000ED030,word,DFBF0000 // ld ra, 0x0(sp)
patch=2,EE,000ED034,word,7BB00010 // lq s0, 0x10(sp)
patch=2,EE,000ED038,word,03E00008 // jr ra
patch=2,EE,000ED03C,word,27BD0020 // addiu sp, sp, 32
patch=2,EE,000ED040,word,27BDFFA0 // JOINAS: addiu sp, sp, -96  ; Lua C function W4P_JoinAs(handle): the first connected pad without a character joins as this AI human (player 3/4 only); returns 1 or nothing (nil)
patch=2,EE,000ED044,word,FFBF0000 // sd ra, 0x0(sp)
patch=2,EE,000ED048,word,7FB00010 // sq s0, 0x10(sp)
patch=2,EE,000ED04C,word,7FB10020 // sq s1, 0x20(sp)
patch=2,EE,000ED050,word,7FB20030 // sq s2, 0x30(sp)
patch=2,EE,000ED054,word,7FB30040 // sq s3, 0x40(sp)
patch=2,EE,000ED058,word,0080982D // daddu s3, a0, zero  ; L
patch=2,EE,000ED05C,word,3C08000F // lui t0, 0x000F
patch=2,EE,000ED060,word,8D09D3E0 // lw t1, -0x2C20(t0)  ; N_CALL 0x000ED3E0
patch=2,EE,000ED064,word,25290001 // addiu t1, t1, 1
patch=2,EE,000ED068,word,AD09D3E0 // sw t1, -0x2C20(t0)
patch=2,EE,000ED06C,word,24050001 // addiu a1, zero, 1
patch=2,EE,000ED070,word,0C102472 // jal 0x004091C8  ; Lua argument 1 as a number (0 if absent), as every binding
patch=2,EE,000ED074,word,0000302D // daddu a2, zero, zero
patch=2,EE,000ED078,word,0C10B108 // jal 0x0042C420  ; number -> unsigned handle
patch=2,EE,000ED07C,word,0040202D // daddu a0, v0, zero
patch=2,EE,000ED080,word,AFA20050 // sw v0, 0x50(sp)
patch=2,EE,000ED084,word,0C0E4060 // jal 0x00390180  ; handle -> object (as the HuDelete core FUN_00233EF0)
patch=2,EE,000ED088,word,27A40050 // addiu a0, sp, 80
patch=2,EE,000ED08C,word,0C08A61A // jal 0x00229868  ; object -> human or 0
patch=2,EE,000ED090,word,0040202D // daddu a0, v0, zero
patch=2,EE,000ED094,word,10400034 // beq v0, zero, 0x000ED168
patch=2,EE,000ED098,word,0040802D // daddu s0, v0, zero  ; human
patch=2,EE,000ED09C,word,820801B0 // lb t0, 0x1B0(s0)  ; player index, -1 = AI
patch=2,EE,000ED0A0,word,2409FFFF // addiu t1, zero, -1
patch=2,EE,000ED0A4,word,15090030 // bne t0, t1, 0x000ED168  ; already a player
patch=2,EE,000ED0A8,word,3C0A0051 // lui t2, 0x0051
patch=2,EE,000ED0AC,word,8D51489C // lw s1, 0x489C(t2)  ; GameMgr
patch=2,EE,000ED0B0,word,86280224 // lh t0, 0x224(s1)  ; player count
patch=2,EE,000ED0B4,word,29090002 // slti t1, t0, 2
patch=2,EE,000ED0B8,word,1520002B // bne t1, zero, 0x000ED168  ; only players 3 and 4 (players 1 and 2 must be in)
patch=2,EE,000ED0BC,word,29090004 // slti t1, t0, 4
patch=2,EE,000ED0C0,word,11200029 // beq t1, zero, 0x000ED168  ; four players already
patch=2,EE,000ED0C4,word,3C12005E // lui s2, 0x005E
patch=2,EE,000ED0C8,word,2652D810 // addiu s2, s2, -10224  ; 0x005DD810: state of pad 0 (0x50 per pad)
patch=2,EE,000ED0CC,word,0000582D // daddu t3, zero, zero  ; pad
patch=2,EE,000ED0D0,word,8E4C004C // ja_pad: lw t4, 0x4C(s2)  ; connected (the game's drop-in loop 0x00159218 tests the same word)
patch=2,EE,000ED0D4,word,11800003 // beq t4, zero, 0x000ED0E4
patch=2,EE,000ED0D8,word,864D0042 // lh t5, 0x42(s2)  ; owner: game player index, -1 = free
patch=2,EE,000ED0DC,word,05A00007 // bltz t5, 0x000ED0FC
patch=2,EE,000ED0E0,word,00000000 // nop
patch=2,EE,000ED0E4,word,256B0001 // ja_next: addiu t3, t3, 1
patch=2,EE,000ED0E8,word,296C0008 // slti t4, t3, 8
patch=2,EE,000ED0EC,word,1580FFF8 // bne t4, zero, 0x000ED0D0
patch=2,EE,000ED0F0,word,26520050 // addiu s2, s2, 80
patch=2,EE,000ED0F4,word,1000001C // beq zero, zero, 0x000ED168
patch=2,EE,000ED0F8,word,00000000 // nop
patch=2,EE,000ED0FC,word,3C0E000E // ja_found: lui t6, 0x000E
patch=2,EE,000ED100,word,ADD025A0 // sw s0, 0x25A0(t6)  ; WANT (spawn.txt X2W): PX takes exactly this human
patch=2,EE,000ED104,word,3C0E000F // lui t6, 0x000F
patch=2,EE,000ED108,word,ADCBD3E8 // sw t3, -0x2C18(t6)  ; LAST_PAD 0x000ED3E8
patch=2,EE,000ED10C,word,8E3256E8 // lw s2, 0x56E8(s1)  ; the script's join flag
patch=2,EE,000ED110,word,240F0001 // addiu t7, zero, 1
patch=2,EE,000ED114,word,AE2F56E8 // sw t7, 0x56E8(s1)  ; UpdateJoin joins only with the flag set (CfgMultiplayerJoin is not called: no UpdateJoin(-1) camera refresh)
patch=2,EE,000ED118,word,0220202D // daddu a0, s1, zero
patch=2,EE,000ED11C,word,0C106918 // jal 0x0041A460  ; UpdateJoin(GameMgr, pad): the game's drop-in join (what W4P X11 calls)
patch=2,EE,000ED120,word,0160282D // daddu a1, t3, zero
patch=2,EE,000ED124,word,AE3256E8 // sw s2, 0x56E8(s1)  ; restore the script's join flag
patch=2,EE,000ED128,word,3C0E000E // lui t6, 0x000E
patch=2,EE,000ED12C,word,ADC025A0 // sw zero, 0x25A0(t6)  ; WANT = 0
patch=2,EE,000ED130,word,820801B0 // lb t0, 0x1B0(s0)
patch=2,EE,000ED134,word,29090002 // slti t1, t0, 2
patch=2,EE,000ED138,word,1520000B // bne t1, zero, 0x000ED168  ; he is not player 3/4 now
patch=2,EE,000ED13C,word,3C0E000F // lui t6, 0x000F
patch=2,EE,000ED140,word,8DC9D3E4 // lw t1, -0x2C1C(t6)  ; N_OK 0x000ED3E4
patch=2,EE,000ED144,word,25290001 // addiu t1, t1, 1
patch=2,EE,000ED148,word,ADC9D3E4 // sw t1, -0x2C1C(t6)
patch=2,EE,000ED14C,word,0C10B0B4 // jal 0x0042C2D0  ; 1 -> number
patch=2,EE,000ED150,word,24040001 // addiu a0, zero, 1
patch=2,EE,000ED154,word,0260202D // daddu a0, s3, zero
patch=2,EE,000ED158,word,0C10253A // jal 0x004094E8  ; push it (one result)
patch=2,EE,000ED15C,word,0040282D // daddu a1, v0, zero
patch=2,EE,000ED160,word,10000002 // beq zero, zero, 0x000ED16C
patch=2,EE,000ED164,word,24020001 // addiu v0, zero, 1
patch=2,EE,000ED168,word,0000102D // ja_fail: daddu v0, zero, zero  ; no result: nil
patch=2,EE,000ED16C,word,DFBF0000 // ja_out: ld ra, 0x0(sp)
patch=2,EE,000ED170,word,7BB00010 // lq s0, 0x10(sp)
patch=2,EE,000ED174,word,7BB10020 // lq s1, 0x20(sp)
patch=2,EE,000ED178,word,7BB20030 // lq s2, 0x30(sp)
patch=2,EE,000ED17C,word,7BB30040 // lq s3, 0x40(sp)
patch=2,EE,000ED180,word,03E00008 // jr ra
patch=2,EE,000ED184,word,27BD0060 // addiu sp, sp, 96
patch=2,EE,000ED200,word,0000802D // TAPOFF: daddu s0, zero, zero  ; TAPOFF (from 0x00234490, tap mode turned off for human s1, own handle at sp+0): the command 45 stays for the others while any other player still taps
patch=2,EE,000ED204,word,3C080051 // to_loop: lui t0, 0x0051
patch=2,EE,000ED208,word,8D09489C // lw t1, 0x489C(t0)  ; GameMgr
patch=2,EE,000ED20C,word,852A0224 // lh t2, 0x224(t1)  ; player count
patch=2,EE,000ED210,word,020A582A // slt t3, s0, t2
patch=2,EE,000ED214,word,11600018 // beq t3, zero, 0x000ED278
patch=2,EE,000ED218,word,00106080 // sll t4, s0, 2
patch=2,EE,000ED21C,word,012C2021 // addu a0, t1, t4
patch=2,EE,000ED220,word,0C0E409A // jal 0x00390268  ; player i -> human
patch=2,EE,000ED224,word,24840228 // addiu a0, a0, 552  ; GameMgr+0x228+4*i
patch=2,EE,000ED228,word,10400011 // beq v0, zero, 0x000ED270
patch=2,EE,000ED22C,word,0040902D // daddu s2, v0, zero
patch=2,EE,000ED230,word,1251000F // beq s2, s1, 0x000ED270  ; himself
