patch=2,EE,001B1BB4,word,0C03831A // was 0060F809 jalr ra,v1; PlayerHUD 0/1 Draw with the HUD player context
patch=2,EE,001AF568,word,0C038327 // was 24050001 addiu a1,zero,1; 2-player divider segments: hidden in the 2x2 mode
patch=2,EE,001AFEB8,word,0C038327 // was 24050001 addiu a1,zero,1; 2-player divider segments: hidden in the 2x2 mode
patch=2,EE,00185AEC,word,24902274 // was 24901EB4 addiu s0,a0,0x1EB4 (item 13) -> addiu s0,a0,0x2274 (item 21)
patch=2,EE,00185AF4,word,24110015 // was 2411000D addiu s1,zero,13 -> addiu s1,zero,21

[warriors-4p 4p markers]
author=warriors-4p
description=Experimental: radar icons drawn on their own radar disc (B2 copied them into every quarter as floating 1P/2P/W labels), radars 3-4 get the same icons as radar 2, players 3-4 shown as 3P (red) / 4P (green) labels built at runtime from the game's own 2P art and HUD digits (D22), original label rule otherwise, no stale 2P label on players 3-4 after a merged view, Select health ring of players 3-4 from own per-view sprites; needs hud, 4p, 4p hud B1 and B2 (m6_markers_map.md).

patch=2,EE,00197180,word,2C4200FE // was 384200FF xori v0,v0,0xFF -> sltiu v0,v0,0xFE; FUN_00197168: view 0xFE is drawn like 0xFF (global HUD camera; SHARED copies only 0xFF)
