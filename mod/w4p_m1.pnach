[warriors-4p own view]
author=warriors-4p
description=Online sessions: never merge the players' views (game option 2P Split Screen Merge off).

patch=1,EE,0050B1C4,word,00000000 // live merge option, was 00000001
patch=2,EE,00418AD4,word,AC40B1C4 // was AC45B1C4 (sw a1): the option setter stores 0
patch=2,EE,00121AE0,word,24130001 // was 8C64B1D8 lw a0,-0x4e28(v1) -> addiu s3,zero,1: player 2 view flag = 1
patch=2,EE,00121AEC,word,00A0882D // was 00A4880A movz s1,a1,a0 -> daddu s1,a1,zero: player 1 view flag = 1 (a1 = 1)
patch=2,EE,00120C04,word,10000009 // was 3C013F00 lui at,0x3f00 -> beq zero,zero,0x00120C2C (mode 2: windows and +0x48 not halved)

[warriors-4p hud]
author=warriors-4p
description=Online sessions: each player's radar inside their own view at single-player size (2x2 layout).

patch=2,EE,001AFF48,word,0803C180 // was 3C020051 lui v0,0x51 -> j 0x000F0600
patch=2,EE,001AFF4C,word,00000000 // was 3C013F80 -> nop (delay slot)
patch=2,EE,001AFFA4,word,4600B806 // was C460D42C lwc1 f0,D42C -> mov.s f0,f23 (P2 depth from the cave)
patch=2,EE,001AA648,word,00000000 // was E7A00008 swc1 f0,8(sp): widget keeps the caller's height
patch=2,EE,000F0600,word,3C020051 // lui v0,0x51
patch=2,EE,000F0604,word,3C013F80 // lui at,0x3f80
patch=2,EE,000F0608,word,4481B000 // mtc1 at,f22 (1.0, as 0x001AFF50)
patch=2,EE,000F060C,word,C440D438 // lwc1 f0,D438(v0): P1 depth (as 0x001AFF54)
patch=2,EE,000F0610,word,C457D42C // lwc1 f23,D42C(v0): P2 depth
patch=2,EE,000F0614,word,8C43B1A4 // lw v1,B1A4(v0): layout mode
patch=2,EE,000F0618,word,24010002 // addiu at,zero,2
patch=2,EE,000F061C,word,14610013 // bne v1,at,0x000F066C: not the 2x2 mode
patch=2,EE,000F0620,word,00000000 // nop
patch=2,EE,000F0624,word,C443B20C // lwc1 f3,B20C(v0): HUD scale S
patch=2,EE,000F0628,word,C444B208 // lwc1 f4,B208(v0): HUD aspect A
patch=2,EE,000F062C,word,3C013F00 // lui at,0x3f00: 0.5
patch=2,EE,000F0630,word,44812800 // mtc1 at,f5
patch=2,EE,000F0634,word,460518C2 // mul.s f3,f3,f5: Wz = S/2
patch=2,EE,000F0638,word,46032102 // mul.s f4,f4,f3: W = A*S/2
patch=2,EE,000F063C,word,C446D428 // lwc1 f6,D428(v0): xs (single-player radar x)
patch=2,EE,000F0640,word,0803C1A0 // j 0x000F0680 (TOPZ: zs, raised when 3+ views; 0x000F0644 runs in the delay slot)
patch=2,EE,000F0644,word,46040202 // mul.s f8,f0,f4
patch=2,EE,000F0648,word,46083041 // sub.s f1,f6,f8: P1 x = xs - d1*W
patch=2,EE,000F064C,word,46030202 // mul.s f8,f0,f3
patch=2,EE,000F0650,word,46083880 // add.s f2,f7,f8: P1 z = zs + d1*Wz
patch=2,EE,000F0654,word,46000000 // add.s f0,f0,f0: P1 depth = 2*d1
patch=2,EE,000F0658,word,4604BA02 // mul.s f8,f23,f4
patch=2,EE,000F065C,word,46083500 // add.s f20,f6,f8: P2 x = xs + d2*W
patch=2,EE,000F0660,word,4603BA02 // mul.s f8,f23,f3
patch=2,EE,000F0664,word,46083D40 // add.s f21,f7,f8: P2 z = zs + d2*Wz
patch=2,EE,000F0668,word,4617BDC0 // add.s f23,f23,f23: P2 depth = 2*d2
patch=2,EE,000F066C,word,0806BFD6 // j 0x001AFF58
patch=2,EE,000F0670,word,00000000 // nop
patch=2,EE,000F0680,word,C447D430 // lwc1 f7,D430(v0): zs
patch=2,EE,000F0684,word,8C41B198 // lw at,B198(v0): view count (0x0050B198)
patch=2,EE,000F0688,word,28210003 // slti at,at,3
patch=2,EE,000F068C,word,14200005 // bne at,zero,0x000F06A4: fewer than 3 views, zs unchanged
patch=2,EE,000F0690,word,00000000 // nop
patch=2,EE,000F0694,word,3C013D4C // lui at,0x3d4c
patch=2,EE,000F0698,word,3421CCCD // ori at,at,0xcccd: 0.05
patch=2,EE,000F069C,word,44812800 // mtc1 at,f5
patch=2,EE,000F06A0,word,460539C0 // add.s f7,f7,f5: zs + 0.05
patch=2,EE,000F06A4,word,0803C192 // j 0x000F0648
patch=2,EE,000F06A8,word,00000000 // nop
patch=2,EE,001C598C,word,0803A000 // was C440E9BC lwc1 f0,-0x1644(v0) -> j 0x000E8000 (radar size, update FUN_001C5210)
