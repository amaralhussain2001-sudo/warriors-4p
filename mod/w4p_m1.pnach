patch=2,EE,000E8168,word,3C080062 // lui t0, 0x0062
patch=2,EE,000E816C,word,01111021 // addu v0, t0, s1
patch=2,EE,000E8170,word,90432E10 // lbu v1, 0x2E10(v0)  ; original test for players 1-2
patch=2,EE,000E8174,word,10600003 // beq v1, zero, mk_unm
patch=2,EE,000E8178,word,00000000 // nop
patch=2,EE,000E817C,word,08092E8E // j 0x0024BA38  ; marked (as the original fall-through)
patch=2,EE,000E8180,word,8FA30058 // lw v1, 0x58(sp)  ; the original delay-slot load (0x0024BA34)
patch=2,EE,000E8184,word,08092E99 // mk_unm: j 0x0024BA64  ; not marked (as the original beq target)
patch=2,EE,000E8188,word,8FA30058 // lw v1, 0x58(sp)
patch=2,EE,0024BA20,word,0803A058 // was 3C080062; FUN_0024B780: lui t0,0x62 (always-marked byte 0x00622E10[i]) -> j MARK34 (index >= 2 never marked)
